{
  "name": "update_deadline",
  "description": "修改已有任务的截止时间，适用于用户明确表达延期、改期或重新安排。",
  "domain": "TaskAgent",
  "capabilities": ["UPDATE_TASK_DEADLINE"],
  "supportedPlatforms": ["ios", "android", "harmony"],
  "requiresUiConfirmation": true,
  "parameters": {
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string"
      },
      "newDueTime": {
        "type": "string",
        "description": "新的截止时间，格式必须为 YYYY-MM-DD HH:MM"
      }
    },
    "required": ["taskId", "newDueTime"]
  }
}
