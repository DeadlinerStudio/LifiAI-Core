{
  "name": "create_task",
  "description": "创建单次任务。仅当用户明确表达新增/添加任务时使用，不用于查询。",
  "domain": "TaskAgent",
  "capabilities": ["CREATE_TASK"],
  "supportedPlatforms": ["ios", "android", "harmony"],
  "requiresUiConfirmation": true,
  "parameters": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "dueTime": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
        "description": "截止时间，格式必须为 YYYY-MM-DD HH:MM"
      },
      "note": {
        "type": "string",
        "description": "任务备注"
      }
    },
    "required": ["name"],
    "additionalProperties": false
  }
}
