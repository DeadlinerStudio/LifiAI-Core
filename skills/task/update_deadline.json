{
  "name": "update_deadline",
  "description": "修改已有任务的截止时间，适用于用户明确表达延期、改期或重新安排。",
  "domain": "TaskAgent",
  "capabilities": ["UPDATE_TASK_DEADLINE"],
  "supportedPlatforms": ["ios", "android", "harmony"],
  "requiresUiConfirmation": true,
  "parameters": {
    "type": "object",
    "properties": {
      "taskId": {
        "oneOf": [
          { "type": "string" },
          { "type": "integer" }
        ]
      },
      "task_id": {
        "oneOf": [
          { "type": "string" },
          { "type": "integer" }
        ]
      },
      "newDueTime": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
        "description": "新的截止时间，格式必须为 YYYY-MM-DD HH:MM"
      }
    },
    "anyOf": [
      { "required": ["taskId", "newDueTime"] },
      { "required": ["task_id", "newDueTime"] },
      { "required": ["taskId", "new_due_time"] },
      { "required": ["task_id", "new_due_time"] }
    ],
    "additionalProperties": false
  }
}
