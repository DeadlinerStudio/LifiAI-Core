namespace deadliner_core {
    [Throws=CoreError]
    sequence<FFITask> extract_tasks(string text, string preferred_lang);
};

[Error]
enum CoreError {
    "NetworkError",
    "ParsingFailed",
    "EmptyResponse",
    "MissingAPIKey"
};

dictionary FFITask {
    string name;
    string? due_time;
    string? note;
};

dictionary FFIHabit {
    string name;
    string period;
    i32 times_per_period;
    string goal_type;
    i32? total_target;
};

interface CoreCallback {
    void on_event(CoreEvent event);
};

enum CoreEvent {
    OnThinking(string agent_name),
    OnTextStream(string chunk),
    OnToolRequest(string id, string tool_name, string args_json),
    OnFinish(string primary_intent, sequence<FFITask>? tasks, sequence<FFIHabit>? habits, string? chat_response, string? session_summary),
    OnError(string message)
};

interface DeadlinerCore {
    constructor(string api_key, string base_url, string model_id, string storage_path);

    void set_callback(CoreCallback callback);

    [Async]
    void process_input(string text);

    [Async]
    void submit_tool_result(string id, string result_json);

    sequence<FFITask> get_latest_tasks();
    string get_user_profile();
};
