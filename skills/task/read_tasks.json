{
  "name": "read_tasks",
  "description": "读取用户本地的任务列表，用于去重、冲突检测或补充上下文。",
  "domain": "TaskAgent",
  "capabilities": ["READ_TASK_CONTEXT"],
  "supportedPlatforms": ["ios", "android", "harmony"],
  "requiresUiConfirmation": false,
  "parameters": {
    "type": "object",
    "properties": {
      "timeRangeDays": {
        "type": "integer",
        "minimum": 1,
        "default": 7
      },
      "status": {
        "type": "string",
        "enum": ["OPEN", "DONE", "ALL"],
        "default": "OPEN"
      },
      "keywords": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string"
        }
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      },
      "sort": {
        "type": "string",
        "enum": ["DUE_ASC", "UPDATED_DESC"],
        "default": "DUE_ASC"
      }
    },
    "additionalProperties": false
  }
}
